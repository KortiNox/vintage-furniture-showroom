{
  "root": true,
  "env": {
    "browser": true,
    "es2020": true
  },
  "extends": ["eslint:recommended"],
  "ignorePatterns": ["dist"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": "warn"
  }
}
